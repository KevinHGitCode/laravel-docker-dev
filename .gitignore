# Ignorar todos los archivos en mysql_data excepto .gitkeep
mysql_data/*
!mysql_data/.gitkeep

# Ignorar todos los archivos en src excepto .gitkeep
src/*
!src/.gitkeep

# Otros archivos que no deberían subirse al repositorio
*.log
# Credenciales locales: copia mysql/.env.example a mysql/.env
mysql/.env
